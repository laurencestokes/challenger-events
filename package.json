{
  "name": "challenger-events",
  "version": "0.1.0",
  "description": "Challenger Events - Real-time fitness event management system",
  "scripts": {
    "postinstall": "node scripts/patch-design-system.js",
    "prebuild": "node scripts/write-commit-hash.js",
    "dev": "node server.js",
    "dev:next": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "start:next": "next start",
    "lint": "eslint .",
    "analyze": "ts-node ./scripts/analyzePowerliftingData.ts",
    "commit": "cz",
    "prepare": "husky",
    "check-types": "tsc --noEmit",
    "prettier": "prettier --ignore-path .eslintignore \"**/*.+(js|json|ts|tsx)\"",
    "format": "npm run prettier -- --write",
    "check-format": "npm run prettier -- --check",
    "validate": "npm run check-types && npm run check-format && npm run lint && npm run build",
    "validate-parallel": "npm-run-all --parallel check-types check-format lint build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "author": "",
  "license": "ISC",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@challengerco/challenger-data": "^8.0.0",
    "@challengerco/challenger-fitness-design-system": "^2.0.0",
    "@hookform/resolvers": "^3.3.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "animejs": "^4.2.2",
    "clsx": "^2.1.1",
    "csv-parse": "^5.0.0",
    "d3": "^7.9.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.7.0",
    "html2canvas": "^1.4.1",
    "next": "^16.1.7",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-aria-components": "^1.16.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.50.0",
    "react-icons": "^5.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.2.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.6.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0",
    "zod": "^3.22.4"
  },
  "overrides": {
    "@challengerco/challenger-fitness-design-system": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "next-themes": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "form-data": "^4.0.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.47",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.2.2"
  }
}
